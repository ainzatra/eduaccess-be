// DO NOT MODIFY THIS FILE                                                                  //
// This file is automatically generated by ZenStack CLI and should not be manually updated. //
//////////////////////////////////////////////////////////////////////////////////////////////

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  teacher
  student
}

enum ChoiceType {
  text
  image
}

enum LogAction {
  login
  view_subject
  view_lesson
  submit_activity
}

enum ActivityLevel {
  beginner
  intermediate
  advance
}

enum Gender {
  male
  female
  other
}

enum SubmissionStatus {
  graded
  pending
}

model User {
  id                 String               @id() @default(uuid())
  full_name          String
  username           String               @unique()
  password_hash      String
  role               String
  age                Int?
  condition          String?
  avatar             String?
  nickname           String?
  gender             Gender?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt()
  email              String?              @unique()
  lessons            Lesson[]             @relation("UserLessons")
  sections_taught    Section[]            @relation("SectionTeacher")
  assigned_section   Section[]            @relation("SectionStudents")
  guardian           Guardian?
  todos              Todo[]
  created_activities Activity[]
  submissions        ActivitySubmission[]
}

model Section {
  id         String     @id() @default(uuid())
  name       String     @unique()
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt()
  teacher_id String
  teacher    User       @relation("SectionTeacher", fields: [teacher_id], references: [id])
  subjects   Subject[]  @relation("SectionSubjects")
  students   User[]     @relation("SectionStudents")
  activities Activity[]
}

model Subject {
  id                String     @id() @default(uuid())
  title             String
  description       String?
  image             String?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt()
  assigned_sections Section[]  @relation("SectionSubjects")
  lessons           Lesson[]
  activities        Activity[]
}

model Lesson {
  id           String   @id() @default(uuid())
  title        String
  video_url    String?
  subtitle_url String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt()
  subject_id   String
  subject      Subject  @relation(fields: [subject_id], references: [id])
  created_by   String
  creator      User     @relation("UserLessons", fields: [created_by], references: [id])
}

model Guardian {
  id         String @id() @default(uuid())
  name       String
  email      String @unique()
  contact    String
  student_id String @unique()
  student    User   @relation(fields: [student_id], references: [id])
}

model Todo {
  id         String  @id() @default(uuid())
  title      String
  completed  Boolean @default(false)
  teacher_id String
  teacher    User    @relation(fields: [teacher_id], references: [id])
}

model Activity {
  id                String               @id() @default(uuid())
  title             String
  titleAudio        String?
  instructions      String
  instructionsAudio String?
  questions         String
  level             ActivityLevel
  graded            Boolean              @default(false)
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt()
  subject_id        String
  subject           Subject              @relation(fields: [subject_id], references: [id])
  section_id        String
  section           Section              @relation(fields: [section_id], references: [id])
  teacher_id        String
  teacher           User                 @relation(fields: [teacher_id], references: [id])
  submissions       ActivitySubmission[]
}

model ActivitySubmission {
  id           String           @id() @default(uuid())
  submitted_at DateTime         @default(now())
  score        Int
  schema       String
  status       SubmissionStatus @default(pending)
  activity_id  String
  activity     Activity         @relation(fields: [activity_id], references: [id])
  student_id   String
  student      User             @relation(fields: [student_id], references: [id])
}
