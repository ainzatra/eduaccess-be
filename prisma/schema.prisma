datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  teacher
  student
}

enum ChoiceType {
  text
  image
}

enum LogAction {
  login
  view_subject
  view_lesson
  submit_activity
}

enum Gender {
  male
  female
  other
}

model User {
  id               String    @id() @default(uuid())
  full_name        String
  username         String    @unique()
  password_hash    String
  role             String
  age              Int?
  condition        String?
  avatar           String?
  nickname         String?
  gender           Gender?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt()
  email            String?   @unique()
  lessons          Lesson[]  @relation("UserLessons")
  sections_taught  Section[] @relation("SectionTeacher")
  assigned_section Section[] @relation("SectionStudents")
  guardian         Guardian?
}

model Section {
  id         String    @id() @default(uuid())
  name       String    @unique()
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt()
  teacher_id String
  teacher    User      @relation("SectionTeacher", fields: [teacher_id], references: [id])
  subjects   Subject[] @relation("SectionSubjects")
  students   User[]    @relation("SectionStudents")
}

model Subject {
  id                String    @id() @default(uuid())
  title             String
  description       String?
  image             String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt()
  assigned_sections Section[] @relation("SectionSubjects")
  lessons           Lesson[]
}

model Lesson {
  id           String   @id() @default(uuid())
  title        String
  video_url    String
  subtitle_url String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt()
  subject_id   String
  subject      Subject  @relation(fields: [subject_id], references: [id])
  created_by   String
  creator      User     @relation("UserLessons", fields: [created_by], references: [id])
}

model Guardian {
  id         String @id() @default(uuid())
  name       String
  email      String @unique()
  contact    String
  student_id String @unique()
  student    User   @relation(fields: [student_id], references: [id])
}
