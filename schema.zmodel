/// A sample data source using local sqlite db.
datasource db {
    provider = 'postgresql'
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
  admin
  teacher
  student
}

enum ChoiceType {
  text
  image
}

enum LogAction {
  login
  view_subject
  view_lesson
  submit_activity
}

model User {
  id            String   @id @default(uuid())
  full_name     String
  email         String   @unique
  password_hash String
  role          Role
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Created lessons as teacher
  lessons       Lesson[]        @relation("UserLessons")
  
  // Assigned sections for a teacher
  sections_taught      Section[]        @relation('SectionTeacher')
  
  // Assigned section for the student
  assigned_section      Section[]        @relation('SectionStudents')

  // activities    Activity[]      @relation("UserActivities")
  // submissions   ActivitySubmission[]
  // logs          ActivityLog[]

  @@allow('all', auth().role == 'admin')
  @@allow('all', auth().id == id)
  @@deny('all', true) // deny everything else by default
}

model Section {
  id          String    @id @default(uuid())
  name        String    @unique

  teacher_id  String
  teacher     User      @relation('SectionTeacher',fields: [teacher_id], references: [id])

  subjects    Subject[] @relation('SectionSubjects')
  students    User[]    @relation('SectionStudents')

  @@allow('all', auth().role == 'admin')
  @@allow('read', auth().role == 'student' || auth().role == 'teacher')
  @@deny('all', true) // deny everything else by default
}

model Subject {
  id          String    @id @default(uuid())
  title       String
  description String?
  image       String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  assigned_sections Section[] @relation('SectionSubjects')

  lessons     Lesson[]

  @@allow('all', auth().role == 'admin')
  @@allow('read', auth().role == 'teacher')
  @@allow('read', auth().role == 'student')
  @@deny('all', true)
}

model Lesson {
  id           String   @id @default(uuid())
  title        String
  video_url    String
  subtitle_url String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  subject_id    String
  subject       Subject   @relation(fields: [subject_id], references: [id])

  created_by   String
  creator      User     @relation("UserLessons", fields: [created_by], references: [id])

  // activities   Activity[]

  @@allow('all', auth().role == 'admin')
  @@allow('create', auth().role == 'teacher')
  @@allow('update', auth().role == 'teacher' && created_by == auth().id)
  @@allow('delete', auth().role == 'teacher' && created_by == auth().id)
  @@allow('read', true)
  @@deny('all', true)
}

