/// A sample data source using local sqlite db.
datasource db {
    provider = 'postgresql'
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
    admin
    teacher
    student
}

enum ChoiceType {
    text
    image
}

enum LogAction {
    login
    view_subject
    view_lesson
    submit_activity
}

enum ActivityLevel {
    beginner
    intermediate
    advance
}

enum NotificationType {
    new_activity
    new_submission
    activity_graded
}

enum Gender {
  male
  female
  other
}

enum SubmissionStatus {
    graded
    pending
}

enum Condition {
    deaf
    speech_delay
}

enum MaterialType {
    video
    image
    subtitle
}

model SchoolYear {
    id        String   @id @default(uuid())
    year      String   @unique // e.g., "2025-2026"
    isActive  Boolean  @default(false)
    createdAt DateTime @default(now())
    
    @@allow('all', auth().role == 'admin')
    @@allow('read', true)
}

model User {
    id               String    @id @default(uuid())
    full_name        String
    username         String    @unique
    password_hash    String
    role             String
    age              Int?
    condition        Condition @default(deaf)
    avatar           String?
    nickname         String?
    gender           Gender?
    created_at       DateTime  @default(now())
    updated_at       DateTime  @updatedAt
    birthday         DateTime? 
    archived         Boolean   @default(false)

    notifications   Notification[]

    // For teacher and admin 
    email            String?    @unique

    // Created lessons as teacher
    lessons          Lesson[]  @relation("UserLessons")
  
    // Assigned sections for a teacher
    sections_taught  Section[] @relation('SectionTeacher')
  
    // Assigned section for the student
    assigned_section Section[] @relation('SectionStudents')

    // Student's guardian
    guardian Guardian?

    // Teacher Todos
    todos Todo[]

    // Teacher Created Activities
    created_activities Activity[]

    // Teacher Created Learning Materials
    learning_materials LearningMaterial[] @relation("UserLearningMaterials")

    // activities    Activity[]      @relation("UserActivities")
    submissions   ActivitySubmission[]
    resetOtps     ResetOtp[]
    // logs          ActivityLog[]

    // Retake permissions received by this student
    retake_permissions ActivityRetakePermission[]

    @@allow('all', auth().role == 'admin')           // Admins can do everything
    @@allow('create', auth().role == 'admin')        // Only admins can create users
    @@allow('update', auth().id == id)               // Users can update themselves
    @@allow('read', true)                            // Anyone can read user records
    @@deny('all', true)                              // Deny everything else by default

	reports NarrativeReport[]

	studentProgress StudentProgress[]
}

model Section {
    id         String    @id @default(uuid())
    name       String    @unique
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    school_year String?  @default("2025-2026")
    
    teacher_id String?
    teacher    User?      @relation('SectionTeacher',  fields: [teacher_id], references: [id])

    subjects   Subject[] @relation('SectionSubjects')
    students   User[]    @relation('SectionStudents')
    activities Activity[]
    announcements Announcement[]

    @@allow('all', auth().role == 'admin')
    @@allow('read', auth().role == 'student' || auth().role == 'teacher')
    @@deny('all', true) // deny everything else by default

	narrativeReport NarrativeReport[]
}

model Subject {
    id                String    @id @default(uuid())
    title             String
    description       String?
    image             String?
    created_at        DateTime  @default(now())
    updated_at        DateTime  @updatedAt
    category          Condition @default(deaf)
    school_year       String    @default("2025-2026")

    assigned_sections Section[] @relation('SectionSubjects')

    lessons           Lesson[]
    activities        Activity[]

    @@allow('create', auth().role == 'admin') // admins can create users
    @@allow('all', auth().role == 'admin')
    @@allow('read', auth().role == 'teacher')
    @@allow('read', auth().role == 'student')

	studentProgress StudentProgress[]
}

model Lesson {
    id           String   @id @default(uuid())
    title        String
    created_at   DateTime @default(now())
    updated_at   DateTime @updatedAt
    school_year  String   @default("2025-2026")

    subject_id   String
    subject      Subject  @relation(fields: [subject_id], references: [id])

    created_by   String
    creator      User     @relation("UserLessons", fields: [created_by], references: [id])

    // New relationship to materials
    materials    LessonMaterial[]

    // activities   Activity[]

    @@allow('all', auth().role == 'admin')
    @@allow('create', auth().role == 'teacher')
    @@allow('update', auth().role == 'teacher' && created_by == auth().id)
    @@allow('delete', auth().role == 'teacher' && created_by == auth().id)
    @@allow('read', true)
}

model LearningMaterial {
    id          String   @id @default(uuid())
    title       String
    type        MaterialType
    url         String?
    s3_key      String?
    file_size   Int
    mime_type   String
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt
    school_year String   @default("2025-2026")
    
    created_by  String
    creator     User     @relation("UserLearningMaterials", fields: [created_by], references: [id])
    
    // Materials used in lessons
    lesson_materials LessonMaterial[]
    
    @@allow('create', auth().role == 'teacher')
    @@allow('read', auth().role == 'teacher' || auth().role == 'admin')
    @@allow('update', auth().role == 'teacher' && created_by == auth().id)
    @@allow('delete', auth().role == 'teacher' && created_by == auth().id)
}

model LessonMaterial {
    id                  String   @id @default(uuid())
    created_at          DateTime @default(now())
    
    lesson_id           String
    lesson              Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
    
    material_id         String
    material            LearningMaterial @relation(fields: [material_id], references: [id], onDelete: Cascade)
    
    @@unique([lesson_id, material_id])
}

model Guardian {
  id String @id @default(uuid())
  name String
  email String @unique
  contact String

  student_id String @unique
  student User @relation(fields: [student_id], references: [id])
}

model Todo {
    id String @id @default(uuid())
    title String
    completed Boolean @default(false)
    school_year String @default("2025-2026")
    teacher_id String
    teacher User @relation(fields: [teacher_id], references: [id])
}

model Activity {
  id           String   @id @default(uuid())
  title        String
  titleAudio   String?
  instructions String
  instructionsAudio String?
  questions       String
  level        ActivityLevel
  graded       Boolean  @default(false)
  category     Condition @default(deaf)
  school_year  String   @default("2025-2026")

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  subject_id   String
  subject      Subject  @relation(fields: [subject_id], references: [id])

  section_id   String
  section      Section  @relation(fields: [section_id], references: [id])

  teacher_id   String
  teacher      User  @relation(fields: [teacher_id], references: [id])

  submissions  ActivitySubmission[]
  retake_permissions ActivityRetakePermission[]
  
}

model ActivitySubmission {
  id            String   @id @default(uuid())
  submitted_at  DateTime @default(now())
  score         Int
  schema        String
  status        SubmissionStatus @default(pending)
  version       Int      @default(1)
  is_latest     Boolean  @default(true)
  progressPoints Int?     // Progress points earned from this submission
  previousProgressPoints Int? // Previous progress points to be replaced (for retakes)

  activity_id   String
  activity      Activity @relation(fields: [activity_id], references: [id])

  student_id    String
  student       User     @relation(fields: [student_id], references: [id])

  // Previous submission if this is a retake
  previous_submission_id String?
  previous_submission ActivitySubmission? @relation("SubmissionRetake", fields: [previous_submission_id], references: [id])
  
  // Next submission if this has been retaken
  next_submissions ActivitySubmission[] @relation("SubmissionRetake")

  @@unique([activity_id, student_id, version])
}

model ActivityRetakePermission {
  id String @id @default(uuid())
  created_at DateTime @default(now())
  
  activity_id String
  activity Activity @relation(fields: [activity_id], references: [id])
  
  student_id String
  student User @relation(fields: [student_id], references: [id])
  
  reason String?
  
  @@unique([activity_id, student_id])
}

model Notification {
    id          String      @id @default(uuid())
    title       String
    description String?
    type        NotificationType @default(new_activity)
    isRead      Boolean     @default(false)
    createdAt   DateTime    @default(now())
    school_year String      @default("2025-2026")

    subject_id  String
    activity_id String
    user_id     String
    user        User        @relation(fields: [user_id], references: [id])
}

model Announcement {
    id          String      @id @default(uuid())
    title       String
    description String?
    createdAt   DateTime    @default(now())
    school_year String      @default("2025-2026")

    section_id  String
    section     Section     @relation(fields: [section_id], references: [id])

}

model ResetOtp {
  id        String   @id @default(uuid())
  otp       String
  user_id   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [user_id], references: [id])
}

model NarrativeReport {
  id                                String   @id @default(uuid())
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
  schoolYear                        String

  student_id                        String
  student                           User     @relation(fields: [student_id], references: [id])

  section_id                        String
  section                           Section  @relation(fields: [section_id], references: [id])

  // Json fields should only accept String[]
  behavior                          Json
  speechAndLanguage                 Json
  fineMotor                         Json
  grossMotor                        Json
  activitiesForDailyLivingSkills    Json
  cognitive                         Json
  areasForDevelopment               Json
  strategies                        Json
  recommendations                   Json
  conclusion                        String

  @@unique([student_id, section_id, schoolYear])
}

model NarrativeReportSettings {
    id        String   @id @default(uuid())
    principal String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ProgressLevel {
    id          String       @id @default(uuid())
    level       ActivityLevel // beginner, intermediate, advance
    minPoints   Int          // Minimum points required for this level
    maxPoints   Int          // Maximum points for this level (exclusive)
    pointValue  Int          // Maximum progress points that can be earned from activities at this level
    schoolYear  String       @default("2025-2026")
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt()
    
    @@unique([level, schoolYear])
    @@allow('all', auth().role == 'admin')
    @@allow('read', true)
}

model StudentProgress {
    id            String   @id @default(uuid())
    studentId     String
    student       User     @relation(fields: [studentId], references: [id])
    subjectId     String
    subject       Subject @relation(fields: [subjectId], references: [id])
    currentLevel  ActivityLevel @default(beginner)
    totalPoints   Int      @default(0)
    schoolYear    String   @default("2025-2026")
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt()
    
    @@unique([studentId, subjectId, schoolYear])
    @@allow('read', auth().id == studentId || auth().role == 'admin' || auth().role == 'teacher')
    @@allow('all', auth().role == 'admin')
}